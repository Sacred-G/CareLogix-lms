		<screen_id x="0" y="0">402</screen_id>
		<Template>4</Template>
		
		<Content height="234" width="566" x="221" y="229" padding="20" hasBackground="true" bgColor="#ffffff" bgAlpha="0.9" auto_narrator="true">
			<![CDATA[
			<p style="font-family: SANS-SERIF; font-size: 24px; color:#404448">To effectively use person-first language, always address the individual directly and respect their preferred communication methods. This includes being attentive to nonverbal cues and alternative communication tools. Such practices demonstrate empathy and understanding, essential for respectful communication.</p>]]>
		</Content>
		
		<Narrator/>


