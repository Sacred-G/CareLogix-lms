	</screen>
	<screen>
		<screen_id x="0" y="0">502</screen_id>
		<Template>4</Template>
		
		<Content height="172" width="779" x="0" y="315" padding="20" hasBackground="true" bgColor="#ffffff" bgAlpha="0.9" auto_narrator="true">
			<![CDATA[
			<p style="font-family: SANS-SERIF; font-size: 24px; color:#404448">Confidentiality is a key responsibility for DSPs, who must protect personal health information in compliance with HIPAA regulations. Handling sensitive data appropriately is crucial to maintaining trust and legal compliance. DSPs must be trained in the ethical and legal aspects of confidentiality to ensure they uphold these standards.</p>]]>
		</Content>
		
		<Narrator/>


		<Video/>
		<Background>images/ai-1746202317-706.jpg</Background>
		<navigation/>
	</screen>
	<screen>
		<screen_id x="0" y="0">503</screen_id>
		<Template>4</Template>
		
		<Content height="296" width="414" x="615" y="32" padding="20" hasBackground="true" bgColor="#ffffff" bgAlpha="0.9" auto_narrator="true">
			<![CDATA[
			<p style="font-family: SANS-SERIF; font-size: 24px; color:#404448">Supporting independence and self-determination is at the heart of a DSP's role. Encouraging individuals to make choices and take reasonable risks helps them take charge of their lives. DSPs empower individuals by providing guidance and support, fostering an environment where they can thrive.</p>]]>
		</Content>
		
