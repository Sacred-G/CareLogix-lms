{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/_next/static/(.*)", "destination": "/_next/static/$1" },
    { "source": "/static/(.*)", "destination": "/static/$1" },
    { "source": "/certificate-preview", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/courses", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "trailingSlash": false,
  "cleanUrls": true,
  "regions": ["iad1"]
}
